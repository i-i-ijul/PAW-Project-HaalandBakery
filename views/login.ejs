<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Toko Roti</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #fdf8f5; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .login-card { background: #ffffff; padding: 2rem 2.5rem; border-radius: 12px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); width: 100%; max-width: 400px; }
        .login-card h2 { margin-top: 0; margin-bottom: 0.5rem; color: #4a2c18; text-align: center; }
        .login-card p.subtitle { margin-top: 0; margin-bottom: 1.5rem; color: #7d6658; font-size: 0.9rem; text-align: center; }
        .form-group { margin-bottom: 1.2rem; }
        .form-group label { display: block; margin-bottom: 0.4rem; font-weight: 600; color: #4a2c18; font-size: 0.9rem; }
        .form-group input { width: 100%; padding: 0.75rem; border: 1px solid #d9c8be; border-radius: 8px; font-size: 0.95rem; outline: none; transition: border-color 0.2s; }
        .form-group input:focus { border-color: #b86b35; }
        .btn-login { width: 100%; padding: 0.8rem; background-color: #b86b35; color: white; border: none; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; margin-top: 0.5rem; transition: background-color 0.2s; }
        .btn-login:hover { background-color: #9c5727; }
        .alert-error { background-color: #fee2e2; color: #b91c1c; padding: 0.7rem; border-radius: 8px; font-size: 0.85rem; margin-bottom: 1rem; text-align: center; }
        .register-link { text-align: center; margin-top: 1.2rem; font-size: 0.85rem; color: #7d6658; }
        .register-link a { color: #b86b35; text-decoration: none; font-weight: 600; }
    </style>
</head>
<body>

<div class="login-card">
    <h2>Selamat Datang</h2>
    <p class="subtitle">Masuk ke akun Anda untuk melanjutkan</p>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="contoh@email.com" required>
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Masukkan password" required>
        </div>

        <button type="submit" class="btn-login">Masuk</button>
    </form>

    <div class="register-link">
        Belum punya akun? <a href="/register">Daftar di sini</a>
    </div>
</div>

</body>
</html>