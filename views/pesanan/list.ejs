<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lacak Pesanan | <%= judul %></title>
  <link rel="stylesheet" href="/css/app.css" />
  <style>
    .page-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 18px; }
    .page-head h1 { margin: 0; font-size: 24px; }
    .page-sub { color: var(--muted); font-size: 13px; }
  </style>
</head>
<body>
  <div class="shell">
    <nav class="session-bar">
      <div class="session-user">
        <b><span id="session-nama"></span></b>
        <span class="role-badge" id="session-role"></span>
      </div>
      <div class="spacer"></div>
      <a class="link-button" href="/">← Beranda</a>
      <button class="link-button" id="btn-logout">Keluar</button>
    </nav>

    <div class="page-head">
      <div>
        <h1>Lacak Pesanan</h1>
        <p class="page-sub"><%= role === "penjual" ? "Pantau & perbarui status pesanan toko kamu." : "Pantau status pesanan yang kamu beli." %></p>
      </div>
      <% if (role === "pembeli") { %>
        <div class="list-actions">
          <button class="btn btn-sm" id="btn-buat-pesanan">Buat Pesanan</button>
        </div>
      <% } %>
    </div>

    <!-- ===== pesanan sudah ada ===== -->
    <div id="list-pesanan" class="list-wrap">
      <div class="loading">Memuat pesanan...</div>
    </div>

    <!-- ===== form buat pesanan (hanya pembeli) ===== -->
    <div id="form-buat" class="card" style="display:none">
      <h3>Buat Pesanan Baru</h3>
      <p class="hint">Pilih toko yang ingin dibeli, lalu lengkapi data pesanan.</p>
      <form id="form-pesanan">
        <div class="field">
          <label for="p_sel_toko">Toko (penjual)</label>
          <select id="p_sel_toko" name="penjual_id" required>
            <option value="">-- Pilih toko --</option>
          </select>
        </div>
        <div class="field">
          <label for="p_produk">Nama Produk</label>
          <input id="p_produk" name="produk_nama" placeholder="Contoh: Roti Gandum" required />
        </div>
        <div class="field">
          <label for="p_harga">Harga (Rp)</label>
          <input id="p_harga" name="harga" type="number" placeholder="15000" required />
        </div>
        <div class="row">
          <div class="field" style="flex:1">
            <label for="p_jumlah">Jumlah</label>
            <input id="p_jumlah" name="jumlah" type="number" value="1" min="1" required />
          </div>
          <div class="field" style="flex:1">
            <label for="p_stok">Stok Tersedia</label>
            <input id="p_stok" name="stok" type="number" placeholder="50" required />
          </div>
        </div>
        <div class="field">
          <label for="p_alamat">Alamat Pengiriman</label>
          <textarea id="p_alamat" name="alamat_pengiriman" rows="2" placeholder="Jl. Contoh No.1, Kota" required></textarea>
        </div>
        <div class="field">
          <label for="p_catatan">Catatan (opsional)</label>
          <input id="p_catatan" name="catatan" placeholder="Contoh: kirim ke rumah" />
        </div>
        <button class="btn btn-block" type="submit">Kirim Pesanan</button>
      </form>
    </div>

    <div class="card" style="margin-top:18px" id="alert-pesan"></div>
  </div>

  <script src="/js/app.js"></script>
  <script>
    (function () {
      const listEl = document.getElementById("list-pesanan");
      const formBuat = document.getElementById("form-buat");
      const pilihToko = document.getElementById("p_sel_toko");
      const btnBuat = document.getElementById("btn-buat-pesanan");
      const formPesanan = document.getElementById("form-pesanan");
      const alertEl = document.getElementById("alert-pesan");

      function pesan(txt, tipe) {
        alertEl.textContent = txt;
        alertEl.className = "card " + (tipe || "");
      }

      function penanda(status) {
        const map = {
          menunggu_pembayaran: "Menunggu Pembayaran",
          dikonfirmasi: "Dikonfirmasi",
          diproses: "Diproses",
          dikirim: "Dikirim",
          diterima: "Diterima",
          batal: "Dibatalkan"
        };
        return map[status] || status;
      }

      function statusPills(status) {
        const order = ["menunggu_pembayaran","dikonfirmasi","diproses","dikirim","diterima"];
        const i = order.indexOf(status);
        let html = "";
        for (let k = 0; k <= i; k++) {
          const s = order[k];
          html += `<span class="status-pill ${s}"><span class="dot"></span>${penanda(s)}</span>`;
        }
        return html;
      }

      async function loadSellers() {
        let html = '<option value="">-- Pilih toko --</option>';
        try {
          const data = await fetch("/api/usaha/list", { credentials: "same-origin" }).then(r => r.json());
          const sellers = data.data || [];
          if (!sellers.length) {
            html += `<option value="">-- Belum ada toko --</option>`;
          } else {
            sellers.forEach(s => {
              html += `<option value="${s.id}">${s.nama_toko} — ${s.nama} (${s.nomor_telepon})</option>`;
            });
          }
        } catch (_) {}
        pilihToko.innerHTML = html;
      }

      async function loadPesanan() {
        try {
          const data = await fetch("/api/pesanan", { credentials: "same-origin" }).then(r => r.json());
          const orders = data.data || [];
          listEl.innerHTML = "";
          if (!orders.length) {
            const msg = document.createElement("div");
            msg.className = "empty";
            msg.textContent = "Belum ada pesanan. " + (role === "pembeli" ? "Pilih toko di atas untuk memesan." : "Tidak ada pesanan dalam toko Anda.");
            listEl.appendChild(msg);
            return;
          }
          orders.forEach(o => {
            const p = document.createElement("div");
            p.className = "order";
            const penjualNama = o.penjual_nama || o.penjual || o.penjual_id;
            const pembeliNama = o.pembeli_nama || o.pembuai || o.pembelian;
            const isSeller = role === "penjual";
            let updateForm = "";
            if (isSeller) {
              updateForm = `
                <form class="form-grid" data-update-status="${o.id}">
                  <select class="form-select" name="status">
                    ${["menunggu_pembayaran","dikonfirmasi","diproses","dikirim","diterima"].map(s => {
                      const lbl = penanda(s);
                      return `<option value="${s}" ${s===o.status?'selected':''}>${lbl}</option>`;
                    }).join("")}
                  </select>
                  <button class="btn btn-sm" type="submit">Simpan</button>
                </form>
              `;
            }
            p.innerHTML = `
              <div class="top">
                <b>${escape(o.produk_nama)}</b>
                <span class="pembeli">${isSeller ? "Dari: "+escape(penjualNama) : "Kepada: "+escape(pembeliNama)}</span>
              </div>
              <div class="jdl">${escape(o.deskripsi)}</div>
              <div class="sub">Total: Rp ${Number(o.total_harga||0).toLocaleString('id-ID')} · Jumlah ${o.jumlah} · ${o.dibuat_pada ? new Date(o.dibuat_pada).toLocaleString('id-ID') : ""}</div>
              <div class="meta">
                <div>Alamat: ${escape(o.alamat_pengiriman)}</div>
                <div>Status: ${statusPills(o.status)}</div>
                ${o.nomor_resi ? `<div class="status-pill" style="background:var(--green-bg);color:var(--green)">No. Resi <b>${escape(o.nomor_resi)}</b></div>` : ""}
                ${!isSeller ? `<div>Dibeli oleh: ${escape(o.pembuai || o.pembelian || "")}</div>` : ""}
              </div>
              ${updateForm}
            `;
            listEl.appendChild(p);
          });
          listEl.querySelectorAll("form[data-update-status]").forEach(f => {
            f.addEventListener("submit", async (e) => {
              e.preventDefault();
              const id = f.dataset.updateStatus;
              const status = f.querySelector("select").value;
              try {
                const data = await fetch("/api/pesanan/" + id + "/status", { method:"PUT", credentials:"same-origin", headers:{"Content-Type":"application/json"}, body: JSON.stringify({status}) }).then(r=>r.json());
                if (data.sukses) { pesan(data.pesan, "card"); loadPesanan(); }
                else pesan(data.pesan, "card");
              } catch(err) { pesan(err.message, "card"); }
            });
          });
        } catch (err) {
          const msg = document.createElement("div");
          msg.className = "empty";
          msg.textContent = err.message;
          listEl.appendChild(msg);
        }
      }

      function escape(s) {
        return String(s ?? "").replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;" }[c]));
      }

      // load data
      loadSellers();
      loadPesanan();

      // buat pesanan
      btnBuat.addEventListener("click", () => {
        formBuat.style.display = formBuat.style.display === "none" ? "block" : "none";
      });
      formPesanan.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = formPesanan.querySelector("button[type=submit]");
        btn.disabled = true;
        pesan("Memesan...", "card");
        try {
          const data = await fetch("/api/pesanan", { method:"POST", credentials:"same-origin", headers:{"Content-Type":"application/json"}, body: JSON.stringify(Object.fromEntries(new FormData(formPesanan))) }).then(r=>r.json());
          if (data.sukses) {
            pesan("Pesanan berhasil dibuat!", "card");
            formPesanan.reset();
            loadPesanan();
          } else {
            pesan(data.pesan || "Gagal memesan.", "card");
          }
        } catch (err) { pesan(err.message, "card"); }
        btn.disabled = false;
      });

      // sesi
      (async function init() {
        try {
          const data = await fetch("/api/auth/me", { credentials: "same-origin" }).then(r => r.json());
          const u = data.data || {};
          document.getElementById("session-nama").textContent = u.nama || u.email || "";
          document.getElementById("session-role").textContent = u.role || "anonim";
          document.getElementById("session-role").className = "role-badge " + (u.role||"");
        } catch (_) {}
      })();
    })();
  </script>
</body>
</html>
