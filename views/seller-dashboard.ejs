<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Setup Profil Toko & AI Caption - Toko Roti</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #fdf8f5; margin: 0; padding: 2rem; color: #4a2c18; }
        .container { max-width: 700px; margin: 0 auto; }
        .card { background: #ffffff; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); margin-bottom: 1.5rem; }
        h2, h3 { margin-top: 0; color: #4a2c18; }
        .form-group { margin-bottom: 1.2rem; }
        .form-group label { display: block; margin-bottom: 0.4rem; font-weight: 600; font-size: 0.9rem; }
        .form-group input, .form-group textarea { width: 100%; padding: 0.75rem; border: 1px solid #d9c8be; border-radius: 8px; font-size: 0.95rem; outline: none; }
        .form-group input:focus, .form-group textarea:focus { border-color: #b86b35; }
        .btn { padding: 0.8rem 1.4rem; background-color: #b86b35; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: background-color 0.2s; width: 100%; font-size: 1rem; }
        .btn:hover { background-color: #9c5727; }
        .ai-box { background-color: #faf3ee; padding: 1.2rem; border-radius: 8px; border: 1px dashed #d9c8be; margin-top: 1rem; }
    </style>
</head>
<body>

<div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="margin: 0;">Setup Toko & AI Caption Produk</h2>
        <a href="/seller/profile-preview" style="color: #b86b35; text-decoration: none; font-weight: 600;">Lihat Etalase Toko &rarr;</a>
    </div>
    <p style="color: #7d6658; margin-bottom: 1.5rem;">Lengkapi informasi profil usahamu dan buat caption promosi menggunakan AI.</p>

    <form action="/seller/profile" method="POST">
        <div class="card">
            <h3>1. Informasi Profil Usaha</h3>
            <div class="form-group">
                <label>Nama Toko</label>
                <input type="text" name="nama_toko" value="<%= typeof store !== 'undefined' && store ? store.nama_toko : '' %>" placeholder="Contoh: Toko Roti Berkah" required>
            </div>
            <div class="form-group">
                <label>Nomor Telepon Toko</label>
                <input type="text" name="nomor_telepon" value="<%= typeof store !== 'undefined' && store ? store.nomor_telepon : '' %>" placeholder="Contoh: 081234567890" required>
            </div>
            <div class="form-group">
                <label>Alamat Toko</label>
                <textarea name="alamat_toko" rows="2" placeholder="Alamat lengkap toko" required><%= typeof store !== 'undefined' && store ? store.alamat_toko : '' %></textarea>
            </div>
        </div>

        <div class="card">
            <h3>2. AI Generator Caption Produk</h3>
            <p style="font-size: 0.9rem; color: #7d6658;">Buat deskripsi promosi toko/produk menggunakan AI agar menarik.</p>
            
            <div class="ai-box">
                <div class="form-group">
                    <label>Deskripsi Singkat Toko/Produk Anda</label>
                    <input type="text" id="productInput" placeholder="Contoh: Toko roti artisan dengan menu andalan sourdough keju">
                </div>
                <button type="button" class="btn" style="background-color: #7d6658; margin-bottom: 1rem;" onclick="generateCaption()">Buat Caption dengan AI</button>
                
                <div id="aiLoading" style="display: none; margin-bottom: 0.8rem; font-style: italic; color: #7d6658;">AI sedang meracik caption...</div>
                
                <div class="form-group">
                    <label>Hasil Generate Caption AI</label>
                    <textarea id="aiResultTextarea" name="caption_produk" rows="4" placeholder="Hasil generate AI akan muncul di sini..." required><%= typeof store !== 'undefined' && store ? store.caption_produk : '' %></textarea>
                </div>
            </div>
        </div>

        <button type="submit" class="btn">Simpan Profil & Lanjut ke Etalase Toko</button>
    </form>
</div>

<script>
    async function generateCaption() {
        const productText = document.getElementById('productInput').value;
        const resultTextarea = document.getElementById('aiResultTextarea');
        const loadingDiv = document.getElementById('aiLoading');

        if (!productText.trim()) {
            alert('Masukkan detail produk/toko terlebih dahulu!');
            return;
        }

        loadingDiv.style.display = 'block';

        try {
            const response = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: `Buatkan caption promosi toko roti yang menarik dan menjual berdasarkan: ${productText}` })
            });
            const data = await response.json();
            
            loadingDiv.style.display = 'none';
            resultTextarea.value = data.response || 'Gagal menghasilkan caption.';
        } catch (err) {
            loadingDiv.style.display = 'none';
            alert('Terjadi kesalahan koneksi ke AI.');
        }
    }
</script>

</body>
</html>