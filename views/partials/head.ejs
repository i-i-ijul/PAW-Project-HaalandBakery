<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f1e8">
  <meta name="description" content="Roti artisan yang dipanggang segar, teman sempurna untuk kopi dan waktu santaimu.">
  <title><%= judul %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: light;
      --ink: #29261f;
      --muted: #777064;
      --cream: #f6f1e8;
      --paper: #fffdf8;
      --rust: #a64e32;
      --rust-dark: #843c27;
      --honey: #e7ad55;
      --line: #e9e1d4;
      font-family: "Bricolage Grotesque", system-ui, sans-serif;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background: var(--cream);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    button, a { -webkit-tap-highlight-color: transparent; }

    a:focus-visible {
      outline: 3px solid var(--honey);
      outline-offset: 4px;
      border-radius: 4px;
    }

    .shell { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 88px;
      border-bottom: 1px solid rgb(41 38 31 / 9%);
    }

    .brand { display: inline-flex; align-items: center; gap: 11px; font-size: 20px; font-weight: 800; letter-spacing: -.04em; }
    .brand-mark { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 13px; background: var(--rust); color: white; }
    .brand-mark svg { width: 22px; height: 22px; }
    .site-nav { display: flex; align-items: center; gap: 30px; color: var(--muted); font-size: 14px; font-weight: 600; }
    .site-nav a:hover { color: var(--rust); }
    .site-nav .nav-cta { padding: 11px 17px; border-radius: 999px; background: var(--ink); color: white; transition: background .2s, transform .2s; }
    .site-nav .nav-cta:hover { background: var(--rust); color: white; transform: translateY(-1px); }

    .hero {
      display: grid;
      grid-template-columns: 1fr .92fr;
      align-items: center;
      gap: 70px;
      padding-block: 74px 92px;
    }

    .eyebrow { display: inline-flex; align-items: center; gap: 9px; color: var(--rust); font-size: 12px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
    .eyebrow::before { width: 22px; height: 1px; background: currentColor; content: ""; }
    .hero h1 { max-width: 610px; margin: 20px 0 0; font-size: clamp(45px, 6vw, 72px); font-weight: 800; letter-spacing: -.065em; line-height: .99; }
    .hero h1 span { color: var(--rust); }
    .hero-copy { max-width: 450px; margin: 22px 0 0; color: var(--muted); font-size: 17px; line-height: 1.75; }
    .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 32px; }
    .button-primary { display: inline-flex; align-items: center; gap: 12px; padding: 15px 20px; border-radius: 999px; background: var(--rust); color: white; font-size: 14px; font-weight: 700; box-shadow: 0 8px 18px rgb(166 78 50 / 18%); transition: transform .2s, background .2s; }
    .button-primary:hover { transform: translateY(-2px); background: var(--rust-dark); }
    .button-primary svg { width: 16px; height: 16px; }
    .hero-note { color: var(--muted); font-size: 13px; font-weight: 600; }

    .hero-art {
      position: relative;
      display: grid;
      min-height: 420px;
      overflow: hidden;
      place-items: center;
      border: 1px solid rgb(132 60 39 / 7%);
      border-radius: 34px;
      background: radial-gradient(ellipse at 50% 43%, #f8dfb7 0, #efcf9e 42%, #e8c18a 100%);
      box-shadow: 0 24px 60px rgb(96 65 34 / 10%);
    }

    .hero-art::before, .hero-art::after { position: absolute; border: 1px solid rgb(132 60 39 / 13%); border-radius: 50%; content: ""; }
    .hero-art::before { width: 330px; height: 330px; }
    .hero-art::after { width: 410px; height: 410px; }
    .bread-illustration { position: relative; z-index: 1; width: min(88%, 420px); filter: drop-shadow(0 22px 18px rgb(83 48 26 / 20%)); transform: rotate(-7deg); }
    .fresh-badge { position: absolute; z-index: 2; top: 27px; right: 25px; display: grid; width: 78px; height: 78px; place-content: center; border: 1px solid rgb(255 255 255 / 55%); border-radius: 50%; background: rgb(255 253 248 / 82%); color: var(--rust); font-size: 11px; font-weight: 800; line-height: 1.25; text-align: center; transform: rotate(9deg); }
    .fresh-badge span { font-size: 20px; }
    .status-card { position: absolute; z-index: 3; right: 22px; bottom: 21px; left: 22px; padding: 15px 17px; border: 1px solid rgb(255 255 255 / 80%); border-radius: 17px; background: rgb(255 253 248 / 93%); box-shadow: 0 12px 30px rgb(78 51 24 / 12%); backdrop-filter: blur(12px); }
    .status-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 12px; font-weight: 700; }
    .status-endpoint { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 11px; }
    .status-state { display: inline-flex; align-items: center; gap: 7px; color: #387753; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #4c9a69; box-shadow: 0 0 0 4px rgb(76 154 105 / 13%); }
    .status-output { overflow: hidden; margin: 9px 0 0; color: #766c5c; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }

    .products-section { padding-block: 78px 88px; background: var(--paper); }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
    .section-heading .eyebrow { margin-bottom: 11px; }
    .section-heading h2 { margin: 0; font-size: clamp(32px, 4vw, 44px); font-weight: 800; letter-spacing: -.055em; line-height: 1.05; }
    .section-heading p { max-width: 300px; margin: 0 0 3px; color: var(--muted); font-size: 14px; line-height: 1.65; }
    .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .product-card { position: relative; display: flex; min-height: 246px; flex-direction: column; padding: 23px; overflow: hidden; border: 1px solid var(--line); border-radius: 22px; background: var(--paper); transition: transform .22s, box-shadow .22s, border-color .22s; }
    .product-card:hover { transform: translateY(-5px); border-color: #ddc7a8; box-shadow: 0 16px 34px rgb(70 54 34 / 8%); }
    .product-card::after { position: absolute; top: -34px; right: -28px; width: 112px; height: 112px; border-radius: 50%; background: #f8eee0; content: ""; }
    .product-topline { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; }
    .product-number { display: grid; width: 39px; height: 39px; place-items: center; border-radius: 13px; background: #f7eee2; color: var(--rust); font-size: 13px; font-weight: 800; }
    .product-category { max-width: 65%; color: var(--muted); font-size: 11px; font-weight: 700; text-align: right; }
    .product-info { position: relative; z-index: 1; margin-top: auto; padding-top: 37px; }
    .product-info h3 { margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -.04em; }
    .product-info p { min-height: 44px; margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.65; }
    .product-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 20px; padding-top: 15px; border-top: 1px solid var(--line); }
    .product-price { color: var(--rust); font-size: 17px; font-weight: 800; }
    .product-stock { color: var(--muted); font-size: 11px; font-weight: 600; }

    .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 26px; color: var(--muted); font-size: 12px; }
    .footer-links { display: flex; gap: 18px; font-weight: 600; }
    .footer-links a:hover { color: var(--rust); }

    @media (max-width: 800px) {
      .hero { grid-template-columns: 1fr 1fr; gap: 32px; padding-block: 58px 70px; }
      .hero-art { min-height: 370px; }
      .site-nav { gap: 18px; }
      .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 620px) {
      .shell { width: min(100% - 36px, 480px); }
      .site-header { min-height: 74px; }
      .brand { font-size: 18px; }
      .brand-mark { width: 35px; height: 35px; }
      .site-nav { gap: 14px; }
      .site-nav a:not(.nav-cta) { display: none; }
      .site-nav .nav-cta { padding: 10px 15px; font-size: 12px; }
      .hero { grid-template-columns: 1fr; gap: 36px; padding-block: 55px 64px; }
      .hero h1 { max-width: 460px; font-size: clamp(48px, 13vw, 66px); }
      .hero-copy { font-size: 15px; }
      .hero-art { min-height: 350px; }
      .section-heading { align-items: start; flex-direction: column; gap: 10px; margin-bottom: 24px; }
      .section-heading p { max-width: 360px; }
      .products-section { padding-block: 60px; }
      .product-grid { grid-template-columns: 1fr; gap: 13px; }
      .product-card { min-height: 220px; }
      .site-footer { align-items: start; flex-direction: column; gap: 12px; padding-block: 22px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
