<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; background: #f5f5f5; display: flex; justify-content: center; padding: 20px; }
    #chat-box { width: 100%; max-width: 700px; background: #fff; border-radius: 12px; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
    #messages { height: 400px; overflow-y: auto; padding: 16px; border-bottom: 1px solid #eee; }
    .msg { padding: 10px 14px; border-radius: 12px; margin-bottom: 8px; max-width: 80%; line-height: 1.4; }
    .msg.user { background: #007bff; color: #fff; text-align: right; }
    .msg.bot  { background: #f0f4f8; text-align: left; }
    #input-form { display: flex; gap: 8px; }
    #message { flex: 1; padding: 10px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; }
    #send-btn { padding: 10px 18px; background: #007bff; color: #fff; border: none; border-radius: 8px; cursor: pointer; }
    #send-btn:hover { background: #0056b3; }
  </style>
</head>
<body>
  <div id="chat-box">
    <h2>Chatbot</h2>
    <div id="messages"></div>
    <form id="input-form">
      <input id="message" placeholder="Tulis pesan..." required />
      <button id="send-btn" type="submit">Kirim</button>
    </form>
  </div>

  <script>
    const form = document.getElementById("input-form");
    const messages = document.getElementById("messages");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const text = document.getElementById("message").value.trim();
      if (!text) return;

      // Kirim ke client
      const userMsg = document.createElement("div");
      userMsg.className = "msg user";
      userMsg.textContent = "Kamu: " + text;
      messages.appendChild(userMsg);
      document.getElementById("message").value = "";
      messages.scrollTop = messages.scrollHeight;

      // Kirim ke server + Groq
      const res = await fetch("/chat/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: text }),
      });
      const data = await res.json();
      const botMsg = document.createElement("div");
      botMsg.className = "msg bot";
      botMsg.textContent = "Bot: " + (data.response || "Maaf, ada yang error");
      messages.appendChild(botMsg);
      messages.scrollTop = messages.scrollHeight;
    });
  </script>
</body>
</html>