
<%- include('partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Dashboard Utama - Toko Roti' }) %>
<body>
  <header class="site-header shell">
    <a class="brand" href="/dashboard" aria-label="Beranda">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M5 18.5c2.4-3 4.7-6.5 7-12 2.3 5.5 4.6 9 7 12M7 15h10M9 11.5h6M10.5 8h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span>Toko Roti</span>
    </a>

    <nav class="site-nav" aria-label="Navigasi utama">
    <a href="/dashboard">Dashboard</a>

    <% if (userRole === 'penjual') { %>
        <a href="/seller/dashboard">Pengaturan Toko</a>
        <a href="/seller/profile-preview">Toko Saya</a>
    <% } %>

    <% if (userRole === 'pembeli') { %>
        <a href="/buyer/orders">Pesanan Saya 📦</a>
    <% } %>

    <a href="/login" class="nav-cta" style="background-color: #b94d3b; color: white;">Keluar 🚪</a>
    </nav>
  </header>

  <main class="shell" style="padding-top: 2rem; padding-bottom: 4rem;">

    <!-- Bagian Search Bar Toko -->
    <div style="margin-bottom: 2.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <span style="font-size: 0.9rem; color: #7d6658; font-weight: 600; text-transform: uppercase;">Dashboard Utama</span>
        <h1 style="color: #4a2c18; font-size: 2rem; margin: 0.3rem 0;">Cari Toko Roti & Mitra Kami</h1>
        <p style="color: #6b5344; margin: 0;">Temukan berbagai toko roti artisan terbaik dan kunjungi etalase produknya.</p>
      </div>

      <form action="/dashboard" method="GET" style="display: flex; gap: 0.75rem; max-width: 500px; margin-top: 0.5rem;">
        <input
          type="text"
          name="search"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          placeholder="Cari berdasarkan nama toko..."
          style="flex: 1; padding: 0.8rem 1rem; border: 1px solid #d9c8be; border-radius: 10px; outline: none; font-size: 0.95rem; background: #ffffff;"
        >

        <button type="submit" style="padding: 0.8rem 1.4rem; background-color: #b86b35; color: white; border: none; border-radius: 10px; cursor: pointer; font-weight: 600;">
          Cari
        </button>

        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
          <a href="/dashboard" style="padding: 0.8rem 1rem; background-color: #f3ece6; color: #7d6658; border-radius: 10px; text-decoration: none; display: flex; align-items: center; font-weight: 600; border: 1px solid #d9c8be;">Reset</a>
        <% } %>
      </form>
    </div>

    <!-- Bagian Daftar Toko Terdaftar (Etalase Utama) -->
    <section style="margin-bottom: 3rem;">
      <h2 style="color: #4a2c18; font-size: 1.4rem; margin-bottom: 1.2rem; border-bottom: 2px solid #f3ece6; padding-bottom: 0.5rem;">
        Daftar Toko Roti Terdaftar <%= typeof searchQuery !== 'undefined' && searchQuery ? `(Hasil pencarian: "${searchQuery}")` : '' %>
      </h2>

      <% if (typeof stores !== 'undefined' && stores && stores.length > 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
          <% stores.forEach(function (store) { %>
            <article style="background: white; padding: 1.5rem; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e5d5cc; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.8rem;">
                  <h3 style="margin: 0; color: #4a2c18; font-size: 1.3rem;"><%= store.nama_toko %></h3>
                  <span style="font-size: 0.75rem; background: #faf3ee; color: #b86b35; padding: 0.2rem 0.6rem; border-radius: 20px; font-weight: 600;">Mitra</span>
                </div>

                <p style="font-size: 0.9rem; color: #7d6658; margin: 0.3rem 0;">📞 <%= store.nomor_telepon %></p>
                <p style="font-size: 0.9rem; color: #7d6658; margin: 0.3rem 0;">📍 <%= store.alamat_toko %></p>

                <div style="margin-top: 1rem; background: #faf3ee; padding: 0.8rem; border-radius: 8px; border: 1px solid #f0e1d8;">
                  <span style="font-size: 0.75rem; font-weight: 700; color: #b86b35; display: block; margin-bottom: 0.2rem; text-transform: uppercase;">Tentang Toko:</span>
                  <p style="font-size: 0.85rem; color: #4a2c18; margin: 0; white-space: pre-line; line-height: 1.4;"><%= store.caption_produk || 'Belum ada deskripsi promosi.' %></p>
                </div>
              </div>

              <!-- Tombol Kunjungi Toko -->
              <div style="margin-top: 1.5rem;">
                <a href="/toko/<%= store.id %>" style="display: block; text-align: center; background-color: #b86b35; color: white; padding: 0.75rem; border-radius: 8px; text-decoration: none; font-weight: 600; transition: background-color 0.2s;">
                  Kunjungi Toko & Lihat Menu &rarr;
                </a>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div style="background: white; padding: 2.5rem; text-align: center; border-radius: 12px; border: 1px dashed #d9c8be;">
          <p style="color: #7d6658; font-style: italic; margin: 0;">Tidak ada toko roti yang ditemukan.</p>
        </div>
      <% } %>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/chat-widget') %>
</body>
</html>
