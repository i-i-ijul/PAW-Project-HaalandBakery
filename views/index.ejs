<%- include('partials/head', { judul: judul }) %>
<body>
  <header class="site-header shell">
    <a class="brand" href="/" aria-label="<%= namaToko %>, beranda">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M5 18.5c2.4-3 4.7-6.5 7-12 2.3 5.5 4.6 9 7 12M7 15h10M9 11.5h6M10.5 8h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span><%= namaToko %></span>
    </a>
    <nav class="site-nav" aria-label="Navigasi utama">
      <a href="#produk">Menu</a>
      <a href="/api/produk">API produk</a>
      <a class="nav-cta" href="#produk">Jelajahi roti <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main>
    <section class="hero shell" aria-labelledby="hero-title">
      <div>
        <span class=>Dibuat dengan sepenuh hati</span>
        <h1 id="hero-title">Roti hangat, <span>hari yang</span> lebih baik.</h1>
        <p class="hero-copy">
          Dari dapur kami ke meja kamu. Temukan roti artisan dan kudapan manis yang pas untuk menemani secangkir kopi.
        </p>
        <div class="hero-actions">
          <a class="button-primary" href="#produk">
            Temukan favoritmu
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <span class="hero-note">Dipanggang segar setiap hari</span>
        </div>
      </div>

      <div class="hero-art">
        <span class="fresh-badge"><span aria-hidden="true">✳</span> fresh<br>from the oven</span>
        <svg class="bread-illustration" viewBox="0 0 460 340" fill="none" role="img" aria-label="Ilustrasi roti sourdough artisan">
          <defs>
            <linearGradient id="crust" x1="128" y1="82" x2="312" y2="294" gradientUnits="userSpaceOnUse">
              <stop stop-color="#D99A50"/>
              <stop offset=".48" stop-color="#B76532"/>
              <stop offset="1" stop-color="#8D4329"/>
            </linearGradient>
            <linearGradient id="crumb" x1="144" y1="112" x2="284" y2="270" gradientUnits="userSpaceOnUse">
              <stop stop-color="#F8DDAA"/>
              <stop offset="1" stop-color="#E9B96F"/>
            </linearGradient>
          </defs>
          <ellipse cx="232" cy="279" rx="157" ry="25" fill="#6F4229" fill-opacity=".16"/>
          <path d="M79 235c-13-35 3-76 25-112 21-34 57-57 105-63 56-7 111 13 145 49 32 34 47 79 31 116-17 39-66 60-151 62-77 2-137-12-155-52Z" fill="url(#crust)"/>
          <path d="M116 221c-8-28 4-60 24-88 18-25 46-42 81-46 43-5 83 11 109 38 24 26 35 58 23 85-13 29-52 45-116 47-58 2-108-8-121-36Z" fill="url(#crumb)" fill-opacity=".47"/>
          <path d="M145 169c12-24 29-41 51-52m-7 71c13-23 31-40 54-50m-6 69c13-21 31-37 52-47" stroke="#F7D69B" stroke-width="13" stroke-linecap="round"/>
          <path d="M145 169c12-24 29-41 51-52m-7 71c13-23 31-40 54-50m-6 69c13-21 31-37 52-47" stroke="#8F492D" stroke-opacity=".35" stroke-width="2.5" stroke-linecap="round"/>
          <circle cx="125" cy="236" r="3" fill="#F2C680" fill-opacity=".8"/>
          <circle cx="329" cy="219" r="3" fill="#F2C680" fill-opacity=".8"/>
          <circle cx="303" cy="247" r="2.5" fill="#F2C680" fill-opacity=".8"/>
          <circle cx="101" cy="206" r="2.5" fill="#F2C680" fill-opacity=".8"/>
        </svg>
        <div class="status-card" aria-label="Status server">
          <div class="status-heading">
            <span class="status-endpoint">GET /api/status</span>
            <span class="status-state">
              <span id="status-dot" class="status-dot" aria-hidden="true"></span>
              <span id="status-label" aria-live="polite">Menghubungi server</span>
            </span>
          </div>
          <pre id="status-output" class="status-output">Memeriksa koneksi...</pre>
        </div>
      </div>
    </section>

    <section id="produk" class="products-section scroll-mt-6" aria-labelledby="products-title">
      <div class="shell">
        <div class="section-heading">
          <div>
            <span class=>Pilihan dari dapur</span>
            <h2 id="products-title">Temukan teman ngopimu.</h2>
          </div>
          <p>Setiap gigitan dibuat untuk jadi bagian kecil yang menyenangkan dari harimu.</p>
        </div>

        <div class="product-grid">
          <% produk.forEach(function (p, index) { %>
            <article class="product-card">
              <div class="product-topline">
                <span class="product-number"><%= String(index + 1).padStart(2, '0') %></span>
                <span class="product-category"><%= p.kategori %></span>
              </div>
              <div class="product-info">
                <h3><%= p.nama %></h3>
                <p><%= p.deskripsi %></p>
              </div>
              <div class="product-bottom">
                <span class="product-price">Rp <%= p.harga.toLocaleString('id-ID') %></span>
                <span class="product-stock">Tersedia · <%= p.stok %> stok</span>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>
  </main>

  <script>
    (async function () {
      const output = document.getElementById('status-output');
      const label = document.getElementById('status-label');
      const dot = document.getElementById('status-dot');

      try {
        const res = await fetch('/api/status');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        output.textContent = JSON.stringify(data);
        label.textContent = 'Server aktif';
      } catch (err) {
        output.textContent = 'Status server tidak dapat dimuat.';
        label.textContent = 'Tidak terhubung';
        dot.style.background = '#b94d3b';
        dot.style.boxShadow = '0 0 0 4px rgb(185 77 59 / 13%)';
      }
    })();
  </script>

  <%- include('partials/footer') %>
  <%- include('partials/chat-widget') %>
